rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      let isSuperAdmin = request.auth != null && request.auth.token.email == 'justinemerick79@gmail.com';
      let hasUserDoc = exists(/databases/$(database)/documents/users/$(request.auth.uid));
      let isExplicitAdmin = hasUserDoc && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      return isSuperAdmin || isExplicitAdmin;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'user';
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if false;
    }

    match /leagues/{leagueId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated()
        && request.resource.data.commissionerId == request.auth.uid
        && request.resource.data.maxTeams >= 4 
        && request.resource.data.maxTeams <= 10
        && request.resource.data.userIds.size() == 1
        && request.resource.data.userIds[0] == request.auth.uid
        && request.resource.data.status == 'active_not_full';

      allow update: if isAuthenticated() 
        && (
          (request.auth.uid == resource.data.commissionerId)
          ||
          (
            !(request.auth.uid in resource.data.userIds) 
            && request.resource.data.userIds.size() == resource.data.userIds.size() + 1 
            && request.resource.data.userIds.hasAll(resource.data.userIds) 
            && request.resource.data.userIds.hasAny([request.auth.uid]) 
            && request.resource.data.userIds.size() <= resource.data.maxTeams 
            && (
               (request.resource.data.userIds.size() == resource.data.maxTeams && request.resource.data.status == 'active_full') ||
               (request.resource.data.userIds.size() < resource.data.maxTeams && request.resource.data.status == 'active_not_full')
            )
          )
        );

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.commissionerId;

      match /teams/{teamId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
        allow update: if isAuthenticated() && get(/databases/$(database)/documents/leagues/$(leagueId)).data.commissionerId == request.auth.uid;
        allow delete: if isAuthenticated() && get(/databases/$(database)/documents/leagues/$(leagueId)).data.commissionerId == request.auth.uid;
      }
    }

    // PWHL Data Collections - Only admins can write, anyone can read
    match /pwhl_seasons/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
    match /pwhl_projections/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
    match /pwhl_teams/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
    match /pwhl_players/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
    match /pwhl_games/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
    match /pwhl_player_stats/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
    match /pwhl_season_player_stats/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
    // PWHL Game Summaries
    match /pwhl_game_summaries/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
    
    // Fantasy Leagues
    match /fantasy_leagues/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // App Settings
    match /app_settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
    
    // Admin Settings
    match /admin_settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
  }
}
